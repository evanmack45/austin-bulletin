---
layout: layout.njk
title: "Austin Bulletin"
description: "What changed in Austin this morning, and what closes when. One lead, the deadlines, and the source."
permalink: "/"
homeFront: true
---
{% set latest = collections.bulletins | first %}
{% set editionImages = latest.data.images or {} %}
{% set editionDate = latest.date | isoDate %}
{% set desk = latest.inputPath | homeDesk %}
<article class="edited-front paper" data-neutral="false" data-edition="{{ editionDate }}">
  <div class="paper-wrap">
    <div class="paper-main">
      <section class="front-lead" aria-labelledby="front-lead-title">
        {% if desk.kicker %}<p class="kicker">{{ desk.kicker | escape }}</p>{% endif %}
        {% if desk.figure %}<p class="num">{{ desk.figure | escape }}</p>{% endif %}
        <h1 id="front-lead-title">{{ desk.headline | escape }}</h1>
        {% if desk.deck %}<p class="front-deck">{{ desk.deck | escape }}</p>{% endif %}
        {% if desk.action %}
        <p class="if-you">{% if desk.action.label %}<strong>{{ desk.action.label | escape }}</strong> {% endif %}{{ desk.action.text | escape }}{% if desk.action.href %} <a class="front-action" href="{{ desk.action.href | escape }}">{{ desk.action.linkLabel | escape }}</a>{% endif %}</p>
        {% endif %}
        {% if desk.source %}<p class="src front-sources">Source: <a href="{{ desk.source.href | escape }}">{{ desk.source.name | escape }}</a></p>{% endif %}
      </section>
      {% if desk.closes.length %}
      <section class="closes" aria-labelledby="closes-title">
        <h2 class="kicker" id="closes-title">Before it closes</h2>
        {% for item in desk.closes %}
        <article class="card">
          <span class="date-tag">{{ item.when | escape }}</span>
          <h2>{% if item.source %}<a href="{{ item.source.href | escape }}">{{ item.title | escape }}</a>{% else %}{{ item.title | escape }}{% endif %}</h2>
          {% if item.action %}<p class="if-you">{% if item.action.label %}<strong>{{ item.action.label | escape }}</strong> {% endif %}{{ item.action.text | escape }}{% if item.action.href %} <a href="{{ item.action.href | escape }}">{{ item.action.linkLabel | escape }}</a>{% endif %}</p>{% endif %}
          {% if item.source %}<p class="src">{{ item.source.name | escape }}</p>{% endif %}
        </article>
        {% endfor %}
      </section>
      {% endif %}
      <p class="edition-jump"><a href="{{ latest.url }}">Full {{ latest.date | weekday }} edition</a></p>
    </div>
    <aside class="paper-side" aria-labelledby="week-title">
      {% if editionImages.lead %}
      {% set photo = editionImages | leadForStory(editionImages.lead.key) %}
      {% if photo %}{{ photo | safe }}{% endif %}
      {% endif %}
      {% if desk.week.length %}
      <h2 class="kicker" id="week-title">This week</h2>
      {% for item in desk.week %}
      <article class="card">
        {% if item.when %}<span class="date-tag">{{ item.when | escape }}</span> {% endif %}
        <h2>{% if item.source %}<a href="{{ item.source.href | escape }}">{{ item.title | escape }}</a>{% else %}{{ item.title | escape }}{% endif %}</h2>
        {% if item.action %}<p class="if-you">{% if item.action.label %}<strong>{{ item.action.label | escape }}</strong> {% endif %}{{ item.action.text | escape }}{% if item.action.href %} <a href="{{ item.action.href | escape }}">{{ item.action.linkLabel | escape }}</a>{% endif %}</p>{% endif %}
        {% if item.source %}<p class="src">{{ item.source.name | escape }}</p>{% endif %}
      </article>
      {% endfor %}
      {% endif %}
      {% set signupId = "lead" %}
      {% include "signup.njk" %}
    </aside>
  </div>
</article>

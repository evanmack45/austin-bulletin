<p class="source-line" data-budget-exempt><span class="source-group">{% for source in sources %}<span class="source-chunk">{% if loop.first %}<span class="source-label">{% if sources | length == 1 %}Source{% else %}Sources{% endif %}: </span>{% else %}<span class="sep" aria-hidden="true"> · </span>{% endif %}<a href="{{ source.url | escape }}">{{ source.label | tightTokens }}</a></span>{% endfor %}</span></p>

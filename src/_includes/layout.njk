<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="{{ newsletter.csp | escape }}">
  {%- set latestEditionMeta = collections.bulletins | first %}{% if latestEditionMeta %}
  <meta name="edition-date" content="{{ latestEditionMeta.date | isoDate }}">{% endif %}
  {% set meta = page.url | pageMetadata(title, content, description) %}
  <title>{{ meta.title | escape }}</title>
  <meta name="description" content="{{ meta.description | escape }}">
  {% if meta.indexable %}
  <link rel="canonical" href="{{ meta.canonical | escape }}">
  <meta property="og:url" content="{{ meta.canonical | escape }}">
  {% endif %}
  <meta property="og:title" content="{{ meta.title | escape }}">
  <meta property="og:description" content="{{ meta.description | escape }}">
  <meta property="og:type" content="{{ meta.type | escape }}">
  <meta property="og:site_name" content="The Austin Bulletin">
  <meta property="og:image" content="{{ meta.image | escape }}">
  <meta property="og:image:alt" content="{{ meta.imageAlt | escape }}">
  <meta name="twitter:card" content="{{ meta.card | escape }}">
  <meta name="twitter:title" content="{{ meta.title | escape }}">
  <meta name="twitter:description" content="{{ meta.description | escape }}">
  <meta name="twitter:image" content="{{ meta.image | escape }}">
  <meta name="twitter:image:alt" content="{{ meta.imageAlt | escape }}">
{% if meta.type == "article" %}  <script type="application/ld+json">{{ meta | articleJsonLd(page.date) | safe }}</script>
{% endif %}  <link rel="stylesheet" href="/css/style.css">{% if homeFront %}
  <link rel="stylesheet" href="/css/front-cover.css">{% endif %}
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#1b1b1b">
  <link rel="alternate" type="application/atom+xml" title="The Austin Bulletin" href="/feed.xml">
</head>
<body{% if homeFront %} class="home-front"{% endif %} id="top">
  <header class="front-masthead">
    {% if homeFront %}
    {% set latestFront = collections.bulletins | first %}
    {% set previousFront = collections.bulletins[1] | previousPublishedEdition(latestFront) %}
    {% set deskLine = latestFront.inputPath | homeDesk %}
    <div class="masthead-banner">
      <img class="masthead-sky" src="{{ imageCredits.masthead.file | escape }}" alt="{{ imageCredits.masthead.alt | escape }}" width="{{ imageCredits.masthead.width }}" height="{{ imageCredits.masthead.height }}" decoding="async">
      <div class="masthead-title">
        <a class="wordmark" href="/">The Austin Bulletin<span class="masthead-dot" aria-hidden="true">.</span></a>
        <p class="masthead-dateline">{{ latestFront.date | weekday }}, {{ latestFront.date | shortMonthDay }}{% if deskLine.weather %} · {{ deskLine.weather | escape }}{% endif %}{% if previousFront %} <span class="prev-edition">· Previous edition: <a href="{{ previousFront.url | escape }}">{{ previousFront.date | monthDay }}</a></span>{% endif %}</p>
      </div>
    </div>
    <div class="masthead-inner">
      <p class="masthead-label">{{ imageCredits.masthead.caption | escape }}</p>
    {% else %}
    <a class="wordmark" href="/">Austin Bulletin<span class="masthead-dot" aria-hidden="true">.</span></a>
    {% endif %}
    <nav class="site-nav" aria-label="Publication">
      <div class="site-menu">
        <input class="site-menu-toggle" type="checkbox" id="site-menu-toggle" aria-label="Menu">
        <label class="site-menu-button" for="site-menu-toggle">Menu</label>
        <div class="site-menu-panel">
          <a href="/">Today</a>
          <a href="/vote-2026/">Election</a>
          <a href="/archive/">Archive</a>
          <a href="/subscribe/">Subscribe</a>
        </div>
      </div>
    </nav>
    {% if homeFront %}</div>{% endif %}
  </header>
  <main>
    {{ content | safe }}
  </main>
  {% set signupId = "bar" %}
  {% include "signup.njk" %}
  <footer class="site-footer">
    <p>© The Austin Bulletin · Published by Evan McMillan, Austin, Texas · <a href="/about/">About this site</a> · <a href="/corrections/">Corrections</a> · <a href="/feed.xml">RSS</a></p>
    <p>Council records: <a href="https://yallcityhall.org/">Y’all, City Hall</a></p>
  </footer>
  <!-- Cloudflare Web Analytics --><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "fa631a41b1134237bc0c66e3c19f5e5d"}'></script><!-- End Cloudflare Web Analytics -->
  <script>
    // First-party, no-beacon return signal (America/Chicago calendar days).
    (function () {
      try {
        var tz = "America/Chicago";
        var parts = new Intl.DateTimeFormat("en-CA", {
          timeZone: tz, year: "numeric", month: "2-digit", day: "2-digit"
        }).formatToParts(new Date());
        var y = parts.find(p => p.type === "year")?.value;
        var m = parts.find(p => p.type === "month")?.value;
        var d = parts.find(p => p.type === "day")?.value;
        if (!y || !m || !d) return;
        var today = y + "-" + m + "-" + d;
        var key = "abVisitDays";
        var days;
        try { days = JSON.parse(localStorage.getItem(key) || "[]"); }
        catch { days = []; }
        if (!Array.isArray(days)) days = [];
        var hadPriorDistinct = days.some(function (dt) { return dt !== today; });
        if (!days.includes(today)) days.push(today);
        // Unique, keep last ~30
        var seen = Object.create(null), uniq = [];
        for (var i = 0; i < days.length; i++) {
          var dt = days[i];
          if (!seen[dt]) { seen[dt] = 1; uniq.push(dt); }
        }
        var capped = uniq.slice(-30);
        try { localStorage.setItem(key, JSON.stringify(capped)); } catch {}
        var root = document.documentElement;
        root.dataset.abVisitDays = String(capped.length);
        if (hadPriorDistinct) root.dataset.abReturn = "1";
        else delete root.dataset.abReturn;
      } catch (e) {
        /* no-op */
      }
    }());
  </script>
  <script type="module" src="/js/signup.js"></script>
</body>
</html>

---
layout: layout.njk
editionPage: true
hasInlineSignup: true
---
<article class="bulletin" data-pagefind-body>
  {% set editionDate = page.date %}
  {% set editionUrl = page.url %}
  {% set editionIso = editionDate | isoDate %}
  {% set top = content | editionLead(editionIso, editionUrl) %}
  {% set skimBody = content | withStoryAnchors %}
  {% set skim = skimBody | skimList %}
  {% include "edition-head.njk" %}
  {% if editionIso == election2026.date or editionIso == election2026.homepageThrough %}
  <p class="election-banner"><a href="/election/{{ election2026.date }}/">Results page</a></p>
  {% endif %}
  {% if skim.length %}
  <nav class="skim" aria-labelledby="skim-title">
    <h2 id="skim-title">In 60 seconds</h2>
    <ol>
      {% for item in skim %}
      <li><a href="#{{ item.anchor | escape }}">{{ item.title | escape }}</a></li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}
  {{ images | leadForStory(top.storyKey) | safe }}
  {% set glanceData = glance[editionDate | isoDate] %}
  {% include "glance.njk" %}
  {{ skimBody | consolidateStorySources | withStoryPhotos(images, top.storyKey) | withCouncilMeetings(editionIso) | safe }}
</article>
{% set signupId = "edition" %}
{% include "signup.njk" %}

---
layout: layout.njk
editionPage: true
hasInlineSignup: true
cardChrome: true
---
<article class="bulletin{% if edition_cards %} bulletin--cards bulletin--{{ page.date | isoDate }}{% endif %}{% if (page.date | isoDate) == '2026-11-08' %} bulletin--2026-11-08{% endif %}" data-pagefind-body>
  {% set editionDate = page.date %}
  {% set editionUrl = page.url %}
  {% set editionIso = editionDate | isoDate %}
  {% if edition_cards %}
  {% set pack = editionCardData[editionIso] %}
  {% include "edition-cards.njk" %}
  {% else %}
  {% set top = content | editionLead(editionIso, editionUrl) %}
  {% set skimBody = content | withStoryAnchors %}
  {% set prepared = skimBody | consolidateStorySources | withReaderActions | withStoryPhotos(images, top.storyKey) | withCouncilMeetings(editionIso) %}
  {% set pack = prepared | legacyEditionCards %}
  {% set legacyKicker = true %}
  {% set legacyBriefing = pack.briefing %}
  {% if editionIso == election2026.date or editionIso == election2026.homepageThrough %}
  <p class="election-banner"><a href="/election/{{ election2026.date }}/">Results page</a></p>
  {% endif %}
  {% set glanceData = glance[editionDate | isoDate] %}
  {% include "glance.njk" %}
  {% if not images or not images.lead or images.lead.kind != "illustration" %}
  {% set leadFigure = images | leadForStory(top.storyKey) %}
  {% endif %}
  {% if pack.preface %}{{ pack.preface | safe }}{% endif %}
  {% if pack.cards.length %}
  {% include "edition-cards.njk" %}
  {% else %}
  {{ prepared | editionSignup | safe }}
  {% endif %}
  {% endif %}
</article>

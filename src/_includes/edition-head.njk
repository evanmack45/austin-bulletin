{# Expects editionDate and editionUrl to be set by the including template. #}
<header class="edition-head">
  <p class="edition-weekday">{{ editionDate | weekday }}</p>
  <h1 class="edition-date">{{ editionDate | longDate }}</h1>
  <p class="edition-meta">Vol. {{ editionDate | volumeNumeral }} &middot; No. {{ editionUrl | editionNumber(collections.bulletins) }} &middot; <a href="#weather">Weather</a> &middot; <a href="#one-good-thing">One Good Thing</a></p>
</header>

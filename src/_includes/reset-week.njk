<ul class="week-lines" id="week-list">
  {% for item in thisWeek.items %}
  <li>
    <a href="{{ item.link | escape }}">
      <span class="icon icon-20" aria-hidden="true">{{ item.iconFile | icon | safe }}</span>
      <span class="week-date">{{ item.dateLabel | escape }}</span>
      <span class="week-line">{{ item.headline | escape }}</span>
    </a>
    {% if item.source and item.source.url %}
    <a href="{{ item.source.url | escape }}" class="week-source" data-budget-exempt>{{ item.source.label | tightTokens }}</a>
    {% endif %}
  </li>
  {% endfor %}
</ul>

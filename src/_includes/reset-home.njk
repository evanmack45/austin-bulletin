{% set editionDate = (collections.bulletins | first).date | isoDate %}
{% set lead = editionCardData["2026-11-13"].cards | selectattr("lead") | first %}
<article class="reset-home paper-main" data-edition="{{ editionDate }}" data-variant="{{ variant }}">
  
  <div class="story-grid">
    <section class="story-card story-card--lead front-lead" id="lead" data-fold data-animate>
      <img class="share-image" src="/images/2026-11-13/house-permits-desktop-1600.webp" alt="{{ lead.chartAlt | escape }}" width="1600" height="1067">
      <p class="original-kicker">{{ lead.label | escape }}</p>
      <p class="bignum">{{ lead.bignum | escape }} <span class="qual">{{ lead.qualifier | escape }}</span></p>
      <h1><a href="/2026/11/13/#{{ lead.id | escape }}">{{ lead.headline | tightTokens }}</a></h1>
      <p class="card-blurb front-deck">{{ lead.deck | tightTokens }}</p>
      <div class="chart">
        <p class="chart-kicker chart-kicker--sentence">{{ lead.chartKicker | tightTokens }}</p>
        <div class="chart-bars chart-bars--bids" role="img" aria-label="{{ lead.chartAlt | escape }}">
          {% for bar in lead.bars %}
          <div class="chart-col" style="--delay: {{ loop.index0 * 50 }}ms">
            <span class="bar-value{% if bar.hi %} is-hi{% endif %}" data-budget-exempt>{{ bar.value | escape }}</span>
            <span class="bar{% if bar.hi %} bar-hi{% endif %}" style="--h: {{ bar.p }}%; --p: {{ bar.p }}"></span>
            <span class="bar-year{% if bar.hi %} is-hi{% endif %}" data-budget-exempt>{{ bar.label | escape }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
      {% set sources = lead.sources %}
      {% include "source-line.njk" %}
    </section>
    {% if thisWeek.board.tiles.length %}
    <section class="story-card story-card--outcomes" aria-labelledby="week-outcomes">
      <h2 class="ob-kicker" id="week-outcomes">{{ thisWeek.board.dateLabel }} · <b>{{ thisWeek.board.count }} outcomes</b></h2>
      <ul class="ob">
        {% for tile in thisWeek.board.tiles %}
        <li class="t t--{{ tile.role }}">
          <p class="t-tag">{% if tile.tagIcon %}{{ tile.tagIcon | icon | safe }}{% endif %}{{ tile.tag | escape }}</p>
          <p class="t-num{% if tile.markKind == "word" %} t-word{% endif %}">{{ tile.mark | escape }}</p>
          {% if tile.markKind == "tally" %}
          <div class="tally" role="img" aria-label="{{ tile.tallyLabel | escape }}">{% for square in tile.squares %}<i aria-hidden="true"></i>{% endfor %}</div>
          {% endif %}
          <h3 class="t-lab">{% if tile.href %}<a href="{{ tile.href | escape }}">{{ tile.label | escape }}</a>{% else %}{{ tile.label | escape }}{% endif %}</h3>
          {% if tile.markKind == "money" %}
          <div class="t-bar" role="img" aria-label="{{ tile.bar.label | escape }}">
            <span class="fill" style="--w:{{ tile.bar.base }}"></span>
            {% if tile.bar.add %}<span class="add" style="--x:{{ tile.bar.base }};--w:{{ tile.bar.add }}"></span>{% endif %}
            <span class="dot" style="--x:{{ tile.bar.end }}"></span>
            {% if tile.bar.callout %}<p class="call" aria-hidden="true">{{ tile.bar.callout | escape }}</p>{% endif %}
          </div>
          {% if tile.axis %}
          <p class="t-axis" aria-hidden="true"><span>{{ tile.axis[0] | escape }}</span><span>{{ tile.axis[1] | escape }}</span></p>
          {% endif %}
          {% endif %}
          {% if tile.rows.length %}
          <ul class="t-rows">
            {% for row in tile.rows %}
            <li class="t-row"><a href="{{ row.href | escape }}">{{ row.icon | icon | safe }}<span>{{ row.label | escape }}</span></a></li>
            {% endfor %}
          </ul>
          {% endif %}
          {% if tile.note %}
          <p class="t-note">{% if tile.note.date %}{{ tile.note.before | escape }} <span class="nb">{{ tile.note.date | escape }}</span> {{ tile.note.after | escape }}{% else %}{{ tile.note.text | escape }}{% endif %}</p>
          {% endif %}
          <p class="t-src source-line" data-budget-exempt>{% for source in tile.sources %}<span class="source-group">{% if loop.first %}<span class="source-label">Sources:</span>{% else %}<span class="sep" aria-hidden="true">·</span>{% endif %}<a href="{{ source.url | escape }}">{{ source.label | escape }}</a></span>{% endfor %}</p>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    <section class="story-card story-card--week">
      <div id="week-block"{% if thisWeek.items.length == 0 %} hidden{% endif %}>
        <h2 class="week-kicker" id="this-week-a">This week · <span id="week-count">{{ thisWeek.items.length }}</span> <span id="week-word">{% if thisWeek.items.length == 1 %}item{% else %}items{% endif %}</span></h2>
        {% include "reset-week.njk" %}
      </div>
    </section>
  </div>
  
  {% set signupId = "lead" %}
  {% include "signup.njk" %}
</article>

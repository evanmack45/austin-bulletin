{% set editionDate = (collections.bulletins | first).date | isoDate %}
{% set shareAlt = "Chart: 927 Austin affordable rental units lose rent limits in 2027, shown against 268 in 2028, 637 in 2029, 953 in 2030 and 358 in 2031. Source: City of Austin Affordable Housing Inventory." %}
{% set chartAlt = "Chart: Austin affordable rental units whose recorded rent limits end each year. 2027: 927 (highlighted), 2028: 268, 2029: 637, 2030: 953, 2031: 358. An expiration date doesn't by itself mean rents will rise. Source: City of Austin Affordable Housing Inventory." %}
{% set inventory = lead.source.url %}
<article class="reset-home paper-main" data-edition="{{ editionDate }}" data-variant="{{ variant }}">
  {% if variant == "b" %}
  <section class="brief front-lead" id="lead" data-fold data-animate>
    <div class="big-box">
      <img class="share-image" src="/images/reset/share-1200x630.png" alt="{{ shareAlt | escape }}" width="1200" height="630" aria-hidden="true">
      <a class="hero-link" href="/lead-story/">
        <span class="bignum" data-count="{{ lead.callout.value }}">{{ lead.callout.value }}</span>
        <h1>affordable rentals lose rent limits in 2027</h1>
      </a>
      {% set mini = true %}
      {% include "reset-chart.njk" %}
      <p class="source-line" data-budget-exempt>Source: <a href="{{ inventory | escape }}">{{ lead.source.name | escape }}</a></p>
    </div>
    <p class="opener front-deck">More than three times the 268 listed for 2028.</p>
  </section>
  <ul class="axiom-rows">
    <li>
      <span class="icon icon-20" aria-hidden="true">{{ "info-bold" | icon | safe }}</span>
      <p><span class="row-label">Why it matters</span> {{ lead.caveat | escape }}</p>
    </li>
    <li>
      <span class="icon icon-20" aria-hidden="true">{{ "arrow-right-bold" | icon | safe }}</span>
      <p><span class="row-label">What you can do</span> <a href="{{ inventory | escape }}">Open the city inventory and read the 11 properties.</a></p>
    </li>
  </ul>
  <section class="week-lines-wrap" aria-labelledby="this-week">
    <h2 id="this-week">{{ thisWeek.heading | escape }}</h2>
    {% include "reset-week.njk" %}
  </section>
  {% else %}
  <div class="story-grid">
    <section class="story-card story-card--lead front-lead" id="lead" data-fold data-animate>
      <img class="share-image" src="/images/reset/share-1200x630.png" alt="{{ shareAlt | escape }}" width="1200" height="630" aria-hidden="true">
      <a class="hero-link" href="/lead-story/">
        <span class="bignum" data-count="{{ lead.callout.value }}">{{ lead.callout.value }}</span>
        <h1>Affordable rentals lose rent limits in 2027</h1>
      </a>
      <p class="card-blurb front-deck">More than three times the 268 units listed for 2028.</p>
      <p class="chart-kicker" data-budget-exempt><span class="icon icon-20" aria-hidden="true">{{ "house-line-bold" | icon | safe }}</span> CHART</p>
      {% set mini = false %}
      {% include "reset-chart.njk" %}
      <p class="caveat">{{ lead.caveat | escape }}</p>
      <p class="source-line" data-budget-exempt>Source: <a href="{{ inventory | escape }}">{{ lead.source.name | escape }}</a></p>
    </section>
    <section class="story-card story-card--rent">
      <h2>Where 2027 rent limits end</h2>
      <div class="map-frame rent-map">
        {% include "reset/district-2027.svg" %}
      </div>
      <p class="source-line source-ink" data-budget-exempt>Map: City of Austin (CTM, Citygate GIS, Travis County Clerk Elections Division).</p>
    </section>
    <section class="story-card story-card--week">
      <h2 class="week-kicker" id="this-week-a">This week · {{ thisWeek.items | length }} items</h2>
      {% include "reset-week.njk" %}
    </section>
    <section class="story-card story-card--districts">
      <p class="card-num">883</p>
      <h2>Districts 4, 5 and 7</h2>
      <p class="card-blurb">Of the 927 rental units.</p>
      <div class="mini" role="img" aria-label="District 4 has 433 units, District 5 has 264, and District 7 has 186.">
        <div class="mini-row"><span data-budget-exempt>D4</span><span class="mini-bar" style="--h: 100%"></span><span data-budget-exempt>433</span></div>
        <div class="mini-row"><span data-budget-exempt>D5</span><span class="mini-bar" style="--h: 61%"></span><span data-budget-exempt>264</span></div>
        <div class="mini-row"><span data-budget-exempt>D7</span><span class="mini-bar" style="--h: 43%"></span><span data-budget-exempt>186</span></div>
      </div>
      <p class="source-line source-ink" data-budget-exempt><a href="{{ inventory | escape }}">City inventory</a></p>
    </section>
  </div>
  {% endif %}
  {% set signupId = "lead" %}
  {% include "signup.njk" %}
</article>

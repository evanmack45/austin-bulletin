{% set editionDate = (collections.bulletins | first).date | isoDate %}
{% set shareAlt = "Chart: 927 Austin affordable rental units lose rent limits in 2027, shown against 268 in 2028, 637 in 2029, 953 in 2030 and 358 in 2031. Source: City of Austin Affordable Housing Inventory." %}
{% set chartAlt = "Chart: Austin affordable rental units whose recorded rent limits end each year. 2027: 927 (highlighted), 2028: 268, 2029: 637, 2030: 953, 2031: 358. An expiration date doesn't by itself mean rents will rise. Source: City of Austin Affordable Housing Inventory." %}
{% set inventory = lead.source.url %}
<article class="reset-home paper-main" data-edition="{{ editionDate }}" data-variant="{{ variant }}">
  {% if variant == "b" %}
  <section class="brief front-lead" id="lead" data-fold data-animate>
    <div class="big-box">
      <img class="share-image" src="/images/reset/share-1200x630.png" alt="{{ shareAlt | escape }}" width="1200" height="630" aria-hidden="true">
      <a class="hero-link" href="/lead-story/">
        <span class="bignum" data-count="{{ lead.callout.value }}">{{ lead.callout.value }}</span>
        <h1>affordable rentals lose rent limits in 2027</h1>
      </a>
      {% set mini = true %}
      {% include "reset-chart.njk" %}
      <p class="source-line" data-budget-exempt>Source: <a href="{{ inventory | escape }}">{{ lead.source.name | escape }}</a></p>
    </div>
    <p class="opener front-deck">Austin's Affordable Housing Inventory lists 927 rent-restricted rental units with affordability expiration dates in 2027, more than three times the 268 listed for 2028.</p>
  </section>
  <section class="axioms">
    <h2>Why it matters</h2>
    <p class="caveat caveat-paper">{{ lead.caveat | escape }}</p>
    <h2>What you can do</h2>
    <p><a href="{{ inventory | escape }}">Open the city inventory and read the 11 properties.</a></p>
  </section>
  <section class="week-lines-wrap" aria-labelledby="this-week">
    <h2 id="this-week">{{ thisWeek.heading | escape }}</h2>
    {% include "reset-week.njk" %}
  </section>
  {% else %}
  <div class="story-grid">
    <section class="story-card story-card--lead front-lead" id="lead" data-fold data-animate>
      <img class="share-image" src="/images/reset/share-1200x630.png" alt="{{ shareAlt | escape }}" width="1200" height="630" aria-hidden="true">
      <a class="hero-link" href="/lead-story/">
        <span class="bignum" data-count="{{ lead.callout.value }}">{{ lead.callout.value }}</span>
        <h1>Rent limits end in 2027</h1>
      </a>
      <p class="card-blurb front-deck">More than three times the 268 units listed for 2028.</p>
      <p class="chart-kicker" data-budget-exempt><span class="icon icon-20" aria-hidden="true">{{ "house-line-bold" | icon | safe }}</span> CHART</p>
      {% set mini = false %}
      {% include "reset-chart.njk" %}
      <p class="caveat">{{ lead.caveat | escape }}</p>
      <p class="source-line" data-budget-exempt>Source: <a href="{{ inventory | escape }}">{{ lead.source.name | escape }}</a></p>
    </section>
    <section class="story-card story-card--map">
      <p class="card-num">{{ thisWeek.items | length }}</p>
      <h2>This week on the map</h2>
      <p class="card-blurb">City Hall items share one pin.</p>
      <p class="map-kicker" data-budget-exempt>MAP</p>
      <div class="map-frame">
        {% include "reset/district-2027.svg" %}
        <div class="pin-layer">
          {% for pin in thisWeek.pins %}
          <a class="pin" href="#week-list" style="{{ pin.lat | pinStyle(pin.lng, 12, "card") }}" data-pin="{{ loop.index0 }}" aria-expanded="false" aria-controls="pin-card" aria-label="{{ pin.count }} items, {{ pin.location | escape }}">
            <span class="pin-dot">{{ pin.count }}</span>
          </a>
          {% endfor %}
        </div>
      </div>
      <div id="pin-card" class="pin-card" hidden>
        <ul></ul>
      </div>
      {% include "reset-week.njk" %}
      <p class="source-line source-ink" data-budget-exempt>Map: City of Austin (CTM, Citygate GIS, Travis County Clerk Elections Division).</p>
      <script type="application/json" id="week-pins">{{ thisWeek.pinsJson | safe }}</script>
    </section>
    <section class="story-card">
      <p class="card-num">883</p>
      <h2>Districts 4, 5 and 7</h2>
      <p class="card-blurb">Those districts account for 883 of the 927 rental units.</p>
      <div class="mini" role="img" aria-label="District 4 has 433 units, District 5 has 264, and District 7 has 186.">
        <div class="mini-row"><span data-budget-exempt>D4</span><span class="mini-bar" style="--h: 100%"></span><span data-budget-exempt>433</span></div>
        <div class="mini-row"><span data-budget-exempt>D5</span><span class="mini-bar" style="--h: 61%"></span><span data-budget-exempt>264</span></div>
        <div class="mini-row"><span data-budget-exempt>D7</span><span class="mini-bar" style="--h: 43%"></span><span data-budget-exempt>186</span></div>
      </div>
      <p class="source-line source-ink" data-budget-exempt><a href="{{ inventory | escape }}">City inventory</a></p>
    </section>
    <section class="story-card">
      <p class="card-num">882</p>
      <h2>Four rental communities</h2>
      <p class="card-blurb">Cascades, Runnymede, Legacy Ranch and Meadowood account for 882.</p>
      <div class="mini" role="img" aria-label="Cascades 264, Runnymede 252, Legacy Ranch 186, Meadowood 180.">
        <div class="mini-row"><span data-budget-exempt>Cascades</span><span class="mini-bar" style="--h: 100%"></span><span data-budget-exempt>264</span></div>
        <div class="mini-row"><span data-budget-exempt>Runnymede</span><span class="mini-bar" style="--h: 95%"></span><span data-budget-exempt>252</span></div>
        <div class="mini-row"><span data-budget-exempt>Legacy</span><span class="mini-bar" style="--h: 70%"></span><span data-budget-exempt>186</span></div>
        <div class="mini-row"><span data-budget-exempt>Meadowood</span><span class="mini-bar" style="--h: 68%"></span><span data-budget-exempt>180</span></div>
      </div>
      <p class="source-line source-ink" data-budget-exempt><a href="{{ inventory | escape }}">City inventory</a></p>
    </section>
    <section class="story-card">
      <p class="card-num">918</p>
      <h2>Mostly apartment homes</h2>
      <p class="card-blurb">918 of the units are apartments, plus 9 in smaller homes.</p>
      <div class="mini" role="img" aria-label="918 apartments and 9 units in duplexes and single-family homes.">
        <div class="mini-row"><span data-budget-exempt>Apartments</span><span class="mini-bar" style="--h: 100%"></span><span data-budget-exempt>918</span></div>
        <div class="mini-row"><span data-budget-exempt>Other homes</span><span class="mini-bar" style="--h: 4%"></span><span data-budget-exempt>9</span></div>
      </div>
      <p class="source-line source-ink" data-budget-exempt><a href="{{ inventory | escape }}">City inventory</a></p>
    </section>
  </div>
  {% endif %}
  {% set signupId = "lead" %}
  {% include "signup.njk" %}
</article>

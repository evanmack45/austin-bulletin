{% set editionDate = (collections.bulletins | first).date | isoDate %}
{% set shareAlt = "Chart: 927 Austin affordable rental units lose rent limits in 2027, shown against 268 in 2028, 637 in 2029, 953 in 2030 and 358 in 2031. Source: City of Austin Affordable Housing Inventory." %}
{% set chartAlt = "Chart: Austin affordable rental units whose recorded rent limits end each year. 2027: 927 (highlighted), 2028: 268, 2029: 637, 2030: 953, 2031: 358. An expiration date doesn't by itself mean rents will rise. Source: City of Austin Affordable Housing Inventory." %}
<article class="reset-home paper-main" data-edition="{{ editionDate }}" data-variant="{{ variant }}">
  {% if variant == "b" %}
  <section class="b-stage front-lead" id="lead">
    <img class="share-image" src="/images/reset/share-1200x630.png" alt="{{ shareAlt | escape }}" width="1200" height="630" aria-hidden="true">
    <h1 class="sr-only">{{ lead.headline_ref | escape }}</h1>
    <a class="b-card" href="{{ lead.source.url | escape }}" data-fold>
      <span class="b-num">{{ lead.callout.value }}</span>
      <span class="b-line">{{ lead.callout.label | escape }}</span>
    </a>
    <div class="b-map" data-animate>
      {% include "reset/district-2027.svg" %}
      <div class="pin-layer">
        {% for place in lead.properties_2027 %}
        <a class="pin" href="{{ lead.source.url | escape }}" style="{{ place.latitude | pinStyle(place.longitude, place.affordable_units, "b") }}" aria-label="{{ place.name | escape }}, {{ place.affordable_units }} units, District {{ place.council_district }}" aria-expanded="false" aria-controls="pin-card" data-name="{{ place.name | escape }}" data-units="{{ place.affordable_units }}" data-district="{{ place.council_district }}">
          <span class="pin-dot"></span>
          <span class="pin-badge" data-budget-exempt>D{{ place.council_district }}</span>
        </a>
        {% endfor %}
      </div>
    </div>
    <div id="pin-card" class="pin-card" hidden>
      <a href="{{ lead.source.url | escape }}">
        <span class="pin-kicker"></span>
        <span class="pin-name"></span>
      </a>
    </div>
  </section>
  <p class="source-line" data-budget-exempt>Map: City of Austin (CTM, Citygate GIS, Travis County Clerk Elections Division).</p>
  <p class="source-line" data-budget-exempt>Source: <a href="{{ lead.source.url | escape }}">{{ lead.source.name | escape }}</a></p>
  {% else %}
  <section class="night-stage front-lead" id="lead" data-fold data-animate>
    <img class="share-image" src="/images/reset/share-1200x630.png" alt="{{ shareAlt | escape }}" width="1200" height="630" aria-hidden="true">
    <p class="chart-kicker" data-budget-exempt><span class="icon icon-20" aria-hidden="true">{{ "house-line-bold" | icon | safe }}</span> CHART</p>
    <h1>{{ lead.headline_ref | escape }}</h1>
    <p class="bignum" data-count="{{ lead.callout.value }}">{{ lead.callout.value }}</p>
    <p class="callout front-deck">{{ lead.callout.label | escape }}</p>
    <div class="chart" role="img" aria-label="{{ chartAlt | escape }}">
      <div class="chart-bars">
        {% for point in lead.series_by_year %}
        <div class="chart-col" style="--delay: {{ loop.index0 * 50 }}ms">
          <span class="bar-value{% if point.highlight %} is-hi{% endif %}" data-budget-exempt>{{ point.units }}</span>
          <span class="bar{% if point.highlight %} bar-hi{% endif %}" style="--h: {{ point.units | barPercent(lead.series_by_year) }}%"></span>
          <span class="bar-year{% if point.highlight %} is-hi{% endif %}" data-budget-exempt>{{ point.year }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
    <p class="caveat">{{ lead.caveat | escape }}</p>
    <p class="source-line" data-budget-exempt>Source: <a href="{{ lead.source.url | escape }}">{{ lead.source.name | escape }}</a></p>
  </section>
  {% set signupId = "lead" %}
  {% include "signup.njk" %}
  <section class="map-stage" aria-labelledby="map-title" data-animate>
    <h2 id="map-title">Where 2027 rent limits end</h2>
    <p class="legend"><span class="legend-dot" aria-hidden="true"></span> 100 affordable rental units</p>
    <div class="map-frame">
      <p class="map-kicker" data-budget-exempt>MAP</p>
      {% include "reset/districts.svg" %}
      <div class="pin-layer">
        {% for place in lead.properties_2027 %}
        <a class="pin" href="{{ lead.source.url | escape }}" style="{{ place.latitude | pinStyle(place.longitude, place.affordable_units, "a") }}" aria-label="{{ place.name | escape }}, {{ place.affordable_units }} units, District {{ place.council_district }}" aria-expanded="false" aria-controls="pin-card" data-name="{{ place.name | escape }}" data-units="{{ place.affordable_units }}" data-district="{{ place.council_district }}">
          <span class="pin-dot"></span>
          <span class="pin-badge" data-budget-exempt>D{{ place.council_district }}</span>
        </a>
        {% endfor %}
      </div>
    </div>
    <div id="pin-card" class="pin-card" hidden>
      <a href="{{ lead.source.url | escape }}">
        <span class="pin-kicker"></span>
        <span class="pin-name"></span>
      </a>
    </div>
    <p class="source-line" data-budget-exempt>Map: City of Austin (CTM, Citygate GIS, Travis County Clerk Elections Division).</p>
  </section>
  {% endif %}
  {% if variant == "b" %}
  {% set signupId = "lead" %}
  {% include "signup.njk" %}
  {% endif %}
  <section class="week-strip" aria-labelledby="this-week" data-animate>
    <h2 id="this-week">{{ thisWeek.heading | escape }}</h2>
    <ul>
      {% for item in thisWeek.items %}
      <li style="--i: {{ loop.index0 }}">
        <a href="{{ item.url | escape }}">
          <span class="icon icon-20" aria-hidden="true">{{ item.icon | icon | safe }}</span>
          <span class="week-date">{{ item.date | escape }}</span>
          <span class="week-line">{{ item.headline | escape }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </section>
</article>

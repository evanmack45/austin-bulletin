{% set editionDate = (collections.bulletins | first).date | isoDate %}
{% set lead = editionCardData["2026-11-12"].cards | selectattr("lead") | first %}
<article class="reset-home paper-main" data-edition="{{ editionDate }}" data-variant="{{ variant }}">
  
  <div class="story-grid">
    <section class="story-card story-card--lead front-lead" id="lead" data-fold data-animate>
      <img class="share-image" src="/images/2026-11-12/str-licenses-desktop-1600.webp" alt="{{ lead.chartAlt | escape }}" width="1600" height="1067">
      <p class="original-kicker">{{ lead.label | escape }}</p>
      <p class="bignum">{{ lead.bignum | escape }} <span class="qual">{{ lead.qualifier | escape }}</span></p>
      <h1><a href="/2026/11/12/#{{ lead.id | escape }}">{{ lead.headline | tightTokens }}</a></h1>
      <p class="card-blurb front-deck">{{ lead.deck | tightTokens }}</p>
      <div class="chart">
        <p class="chart-kicker chart-kicker--sentence">{{ lead.chartKicker | tightTokens }}</p>
        <div role="img" aria-label="{{ lead.chartAlt | escape }}">{{ strLineChart | safe }}</div>
      </div>
      <p class="chart-source" data-budget-exempt>{{ lead.chartSource | tightTokens }}</p>
      {% set sources = lead.sources %}
      {% include "source-line.njk" %}
    </section>
    <section class="story-card story-card--week">
      {% if thisWeek.outcomes.length %}
      <h2 class="week-kicker" id="week-outcomes">Nov. 10 · {{ thisWeek.outcomes | length }} outcomes</h2>
      <ul class="week-outcomes">
        {% for item in thisWeek.outcomes %}
        <li>
          {% if item.glyph or item.topic %}
          <p class="outcome-mark">{% if item.glyph %}<b><u>{{ item.glyph | escape }}</u></b>{% if item.glyphLabel %}<span>{{ item.glyphLabel | escape }}</span>{% endif %}{% else %}<span class="outcome-topic">{{ item.topic | escape }}</span>{% endif %}</p>
          {% endif %}
          <h3>{{ item.headline | tightTokens }}</h3>
          <p class="outcome-dek">{{ item.text | tightTokens }}</p>
          <p class="source-line{% if item.stackSources %} source-line--stack{% endif %}" data-budget-exempt>{% for source in item.sources %}<span class="source-group">{% if loop.first %}<span class="source-label">{% if item.sources | length == 1 %}Source{% else %}Sources{% endif %}:</span> {% else %} <span class="sep" aria-hidden="true">·</span> {% endif %}<a href="{{ source.url | escape }}">{{ source.label | escape }}</a></span>{% endfor %}</p>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
      <h2 class="week-kicker" id="this-week-a">This week · {{ thisWeek.items | length }} items</h2>
      {% include "reset-week.njk" %}
    </section>
  </div>
  
  {% set signupId = "lead" %}
  {% include "signup.njk" %}
</article>

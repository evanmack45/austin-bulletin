{% set editionDate = (collections.bulletins | first).date | isoDate %}
{% set s = lead.series_by_year %}
{% set hero = s | selectattr("highlight") | first %}
{% set n = hero.units %}
{% set d4 = (lead.by_district_2027 | selectattr("council_district", "equalto", 4) | first) %}
{% set d5 = (lead.by_district_2027 | selectattr("council_district", "equalto", 5) | first) %}
{% set d7 = (lead.by_district_2027 | selectattr("council_district", "equalto", 7) | first) %}
{% set shareAlt = "Chart: " ~ n ~ " Austin affordable rental units lose rent limits in " ~ hero.year ~ ", shown against " ~ s[1].units ~ " in " ~ s[1].year ~ ", " ~ s[2].units ~ " in " ~ s[2].year ~ ", " ~ s[3].units ~ " in " ~ s[3].year ~ " and " ~ s[4].units ~ " in " ~ s[4].year ~ ". Source: City of Austin Affordable Housing Inventory." %}
{% set chartAlt = "Chart: Austin affordable rental units whose recorded rent limits end each year. " ~ hero.year ~ ": " ~ n ~ " (highlighted), " ~ s[1].year ~ ": " ~ s[1].units ~ ", " ~ s[2].year ~ ": " ~ s[2].units ~ ", " ~ s[3].year ~ ": " ~ s[3].units ~ ", " ~ s[4].year ~ ": " ~ s[4].units ~ ". An expiration date doesn't by itself mean rents will rise. Each bar is the sum of affordable units. Source: City of Austin Affordable Housing Inventory." %}
{% set inventory = lead.source.url %}
<article class="reset-home paper-main" data-edition="{{ editionDate }}" data-variant="{{ variant }}">
  
  <div class="story-grid">
    <section class="story-card story-card--lead front-lead" id="lead" data-fold data-animate>
      <img class="share-image" src="/images/reset/share-1200x630.png" alt="{{ shareAlt | escape }}" width="1200" height="630" aria-hidden="true">
      <a class="hero-link" href="/lead-story/">
        <span class="bignum" data-count="{{ n }}">{{ n }}</span>
        <h1>Affordable rentals lose rent limits in 2027</h1>
      </a>
      <p class="card-blurb front-deck">More than three times the {{ s[1].units }} units listed for {{ s[1].year }}.</p>
      <p class="chart-kicker" data-budget-exempt><span class="icon icon-20" aria-hidden="true">{{ "house-line-bold" | icon | safe }}</span> CHART</p>
      {% set mini = false %}
      {% include "reset-chart.njk" %}
      <p class="caveat">{{ lead.caveat | escape }}</p>
      <p class="source-line" data-budget-exempt>Source: <a href="{{ inventory | escape }}">{{ lead.source.name | escape }}</a></p>
    </section>
    <section class="story-card story-card--rent">
      <h2>Where 2027 rent limits end</h2>
      <div class="map-frame rent-map">
        {% include "reset/district-2027.svg" %}
      </div>
      <p class="source-line source-ink" data-budget-exempt>Map: City of Austin (CTM, Citygate GIS, Travis County Clerk Elections Division).</p>
    </section>
    <section class="story-card story-card--week">
      {% if thisWeek.outcomes.length %}
      <h2 class="week-kicker" id="week-outcomes">Nov. 10 · {{ thisWeek.outcomes | length }} outcomes</h2>
      <ul class="week-outcomes">
        {% for item in thisWeek.outcomes %}
        <li>
          <p>{{ item.text | tightTokens }}</p>
          <p class="source-line" data-budget-exempt>{% if item.sources | length == 1 %}Source{% else %}Sources{% endif %}: {% for source in item.sources %}{% if not loop.first %}<span aria-hidden="true"> · </span>{% endif %}<a href="{{ source.url | escape }}">{{ source.label | escape }}</a>{% endfor %}</p>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
      <h2 class="week-kicker" id="this-week-a">This week · {{ thisWeek.items | length }} items</h2>
      {% include "reset-week.njk" %}
    </section>
    <section class="story-card story-card--districts">
      <p class="card-num">{{ lead.key_figures.districts_4_5_7_units_2027 }}</p>
      <h2>Districts 4, 5 and 7</h2>
      <p class="card-blurb">Of the {{ n }} rental units.</p>
      <div class="mini" role="img" aria-label="District 4 has {{ d4.units }} units, District 5 has {{ d5.units }}, and District 7 has {{ d7.units }}.">
        <div class="mini-row"><span data-budget-exempt>D4</span><span class="mini-bar" style="--h: 100%"></span><span data-budget-exempt>{{ d4.units }}</span></div>
        <div class="mini-row"><span data-budget-exempt>D5</span><span class="mini-bar" style="--h: {{ (d5.units / d4.units * 100) | round }}%"></span><span data-budget-exempt>{{ d5.units }}</span></div>
        <div class="mini-row"><span data-budget-exempt>D7</span><span class="mini-bar" style="--h: {{ (d7.units / d4.units * 100) | round }}%"></span><span data-budget-exempt>{{ d7.units }}</span></div>
      </div>
      <p class="source-line source-ink" data-budget-exempt><a href="{{ inventory | escape }}">City inventory</a></p>
    </section>
  </div>
  
  {% set signupId = "lead" %}
  {% include "signup.njk" %}
</article>

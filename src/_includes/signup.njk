{# signupId: lead | edition | page | bar. The embed is Kit's official form. #}
{% set signupNote = newsletter.barNote if signupId == "bar" else newsletter.note %}
<section class="signup signup--{{ signupId }}" data-signup="{{ signupId }}"{% if signupId != "bar" %} data-signup-inline{% endif %}{% if signupId == "bar" %} aria-label="Email the morning edition"{% else %} aria-labelledby="signup-{{ signupId }}-title"{% endif %}>
  {% if signupId != "bar" %}<h2 id="signup-{{ signupId }}-title">The morning edition</h2>{% endif %}
  <div class="signup-bar-top">
    <p class="signup-value" id="signup-{{ signupId }}-value">{{ newsletter.valueLine | escape }}</p>
    {% if signupId == "bar" %}<button type="button" class="signup-dismiss" data-signup-dismiss>Close</button>{% endif %}
  </div>
  <div class="signup-embed">
    <script async data-uid="{{ newsletter.uid | escape }}" src="{{ newsletter.embedSrc | escape }}"></script>
    <noscript><a href="{{ newsletter.formUrl | escape }}">Subscribe by email</a></noscript>
  </div>
  <p class="signup-note" id="signup-{{ signupId }}-note">{{ signupNote | escape }}{% if signupId != "bar" %} <a href="/feed.xml">Or follow by RSS</a>.{% endif %}</p>
</section>
